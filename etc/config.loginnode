include "config.path"
-- 线程个数
thread = 8
-- 启动配置
bootstrap = "snlua bootstrap"   -- The service for bootstrap
start = "loginnode"  -- main script
nodename = "loginnode"
harbor = 0
login_host = "0.0.0.0"
login_port = 9999
default_gate_node = "gatenode"
default_gate_host = "127.0.0.1"
default_gate_port = 8888

luaservice = luaservice..root.."service/login/?.lua;"
