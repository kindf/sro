-- 路径设置
root = "./"
lua_cpath = root .. "skynet/luaclib/?.so;"..root.."lualib/lib/?.so"
cpath = root.."skynet/cservice/?.so"
snax = root.."service/?.lua"


local configservice = root.."service/config/?.lua;"
local gameservice = root.."service/game/?.lua;"
local watchdogservice = root.."service/watchdog/?.lua;"
local worldservice = root.."service/world/?.lua;"
local sceneservice = root.."service/scene/?.lua;"

luaservice = root.."skynet/service/?.lua;"..configservice..gameservice..watchdogservice..worldservice..sceneservice

lualoader = root .. "skynet/lualib/loader.lua"

lua_path = root.."?.lua;"..root.."lualib/?.lua;"..root.."module/?.lua;"..root.."skynet/lualib/?.lua;"
